{
  "name": "scanner-ativos-fundamentalista",
  "version": "2.0.0",
  "description": "Scanner fundamentalista de ações e FIIs da B3, com valuation Graham/Bazin e Selic dinâmica via Banco Central.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test",
    "emuladores": "npx --yes firebase-tools@latest emulators:start --only auth,firestore --project demo-invista",
    "web": "npm --prefix web run dev",
    "mobile": "npm --prefix mobile run start",
    "simular": "node --env-file=.env scripts/simular-depositos.js",
    "instalar-tudo": "npm install && npm --prefix web install && npm --prefix mobile install"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^12.1.0",
    "nodemailer": "^9.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
