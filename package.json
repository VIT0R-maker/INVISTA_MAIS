{
  "name": "scanner-ativos-fundamentalista",
  "version": "3.0.0",
  "description": "Invista+: scanner financeiro e terminal IoT com Web React, Mobile Expo e análise estatística",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test test/*.test.js",
    "build": "vite build",
    "dev:web": "vite",
    "simulate": "node --env-file-if-exists=.env --env-file-if-exists=.env.iot.local scripts/simulate.js",
    "docs:validate": "node scripts/validate-openapi.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^12.1.0",
    "nodemailer": "^9.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "vite": "^8.3.1"
  }
}
