# Somente no servidor. Nunca copie chaves para HTML/JS público ou para o Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Mesmo projeto Firebase usado pelo login da interface.
FIREBASE_PROJECT_ID=invista-ai-63bba
FIREBASE_CLIENT_EMAIL=
# Cole a chave privada da conta de serviço com quebras representadas por \n.
FIREBASE_PRIVATE_KEY=

# Opcionais: relatório do dispositivo IoT.
EMAIL_USER=
EMAIL_PASS=

# Terminal IoT. Gere valores aleatórios longos; mantenha-os fora do Git e do app.
IOT_DEVICE_ID=terminal-01
IOT_DEVICE_TOKEN=
IOT_PAIRING_CODE=
# Produção: Firestore. Somente para desenvolvimento local, opcional: file
IOT_STORAGE=firestore

# Blynk: token do dispositivo, não o Template ID. Use a região da sua conta.
BLYNK_AUTH_TOKEN=
BLYNK_SERVER=blynk.cloud
